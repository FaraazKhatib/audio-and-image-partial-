# The eval set layout is worth committing, the images in it are not. Blanket ignoring the directory
# would stop git descending into it at all, which is why this excludes contents and re-includes the
# directories and their placeholders instead.
backend/eval_data/**
!backend/eval_data/**/
!backend/eval_data/**/.gitkeep

